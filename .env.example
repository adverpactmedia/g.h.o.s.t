# Required for audio transcription and meeting analysis. Server-side only.
GEMINI_API_KEY=

# Required for shared, atomic rate limiting in production. Use the dedicated G.H.O.S.T. project.
# Server-only service role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Recommended: independent signing secret for analysis-poll tokens.
# Generate with: openssl rand -hex 32
GHOST_SESSION_SECRET=

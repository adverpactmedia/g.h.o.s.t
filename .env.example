# Required for audio transcription and meeting analysis.
# Add the real value to .env.local locally and to Vercel Environment Variables.
# Never expose this key with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional: rotate signed analysis-poll tokens independently of the Gemini API key.
# Generate with: openssl rand -hex 32
GHOST_SESSION_SECRET=

# Required for shared API abuse limits and durable, replay-safe STABLOCITY meeting handoffs.
# Apply both SQL migrations in supabase/migrations/ to the existing G.H.O.S.T. Supabase project.
SUPABASE_URL=
# Server-only service role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Shared HMAC secret for STABLOCITY -> G.H.O.S.T. transcript handoff.
# Must exactly match GHOST_WEBHOOK_SECRET in STABLOCITY. Generate 32+ random bytes.
STABLOCITY_GHOST_WEBHOOK_SECRET=
